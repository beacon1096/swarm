# Containerd mirror endpoints for image pulls. Primary cache is the
# in-cluster zot Service LB at 172.16.87.51:5000 (talos-ii pod
# registry/zot-0, Cilium L2 announcement).
#
# factory.talos.dev is intentionally not mirrored here. Talos image
# bootstrap should not depend on the retired LAN zot host; if factory
# pulls need caching again, add a tested in-cluster zot sync path first.
#
# Zot is configured with extensions.sync against the same 9 upstreams;
# upstream egress is provided by the ms-r1 boundary gateway.
machine:
  registries:
    mirrors:
      docker.io:
        endpoints:
          - http://172.16.87.51:5000
      ghcr.io:
        endpoints:
          - http://172.16.87.51:5000
      quay.io:
        endpoints:
          - http://172.16.87.51:5000
      mirror.gcr.io:
        endpoints:
          - http://172.16.87.51:5000
      gcr.io:
        endpoints:
          - http://172.16.87.51:5000
      registry.k8s.io:
        endpoints:
          - http://172.16.87.51:5000
      docker.elastic.co:
        endpoints:
          - http://172.16.87.51:5000
      code.forgejo.org:
        endpoints:
          - http://172.16.87.51:5000
      # n8n's official image registry. Added 2026-04-28 when the
      # first n8n pod sat in ContainerCreating for 5+ min trying to
      # pull `docker.n8n.io/n8nio/n8n:2.15.0` directly across the
      # GFW-flaky default egress. Also synced by zot on both the
      # in-cluster pod.
      docker.n8n.io:
        endpoints:
          - http://172.16.87.51:5000
      # Self-referential entry: tell containerd that the in-cluster zot LB
      # is plain HTTP (not HTTPS, which is the default for image URLs
      # without an explicit scheme).
      "172.16.87.51:5000":
        endpoints:
          - http://172.16.87.51:5000
      # NOTE on forgejo.beaco.works: we deliberately DON'T add a mirror
      # entry here. Talos's containerd uses the host's resolver
      # (172.16.87.254 → UDR Pro), which can't resolve
      # *.svc.cluster.local. Instead `forgejo.beaco.works` is rewritten
      # via /etc/hosts (machine.network.extraHostEntries in the global
      # machine-network patch) to the envoy-internal LB IP 172.16.87.21,
      # and an HTTPRoute on envoy-internal handles the routing back to
      # forgejo-http. The image pull then traverses LAN only — no
      # Cloudflare hop, no CF rate limits, no 502s on big blobs.
